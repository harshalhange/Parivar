{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Furniture product item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "oldPrice": { "type": "number" },
        "category": { "type": "string" },
        "image": { "type": "string" },
        "desc": { "type": "string" },
        "inStock": { "type": "boolean" },
        "stock": { "type": "number" },
        "material": { "type": "string" },
        "room": { "type": "string" },
        "size": { "type": "string" },
        "delivery": { "type": "string" }
      },
      "required": ["id", "name", "price"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "customer": { "type": "object" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "discount": { "type": "number" },
        "coupon": { "type": "string" },
        "total": { "type": "number" },
        "shipping": { "type": "string" },
        "deliveryEstimate": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "total"]
    },
    "User": {
      "title": "User",
      "description": "User profile data",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "city": { "type": "string" },
        "pincode": { "type": "string" }
      },
      "required": ["uid"]
    },
    "Review": {
      "title": "Review",
      "description": "Product review and rating",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "name": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "verified": { "type": "boolean" },
        "date": { "type": "string" }
      },
      "required": ["productId", "rating", "comment"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Discount coupon",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "type": { "type": "string" },
        "value": { "type": "number" },
        "min": { "type": "number" },
        "limit": { "type": "number" },
        "used": { "type": "number" },
        "expiry": { "type": "string" }
      },
      "required": ["code", "type", "value"]
    },
    "B2BQuote": {
      "title": "B2BQuote",
      "description": "B2B bulk quote inquiry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "company": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "qty": { "type": "string" },
        "category": { "type": "string" },
        "note": { "type": "string" }
      },
      "required": ["company", "name", "phone"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Catalog of furniture items"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer purchase orders"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Registered customer profiles"
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Customer reviews and feedback"
    },
    "/coupons/{couponId}": {
      "schema": "Coupon",
      "description": "Promotional discount codes"
    },
    "/b2b_quotes/{quoteId}": {
      "schema": "B2BQuote",
      "description": "Commercial wholesale inquiries"
    }
  }
}
